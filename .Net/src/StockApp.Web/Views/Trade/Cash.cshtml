@{
    ViewData["Title"] = "Cash Management";
    double balance = ViewBag.CashBalance ?? 0.0;
}

<div class="cash-page">
    <div class="cash-card">
        <div class="cash-icon">&#128176;</div>
        <h1 class="cash-title">Your Cash Balance</h1>
        <p class="cash-subtitle">Manage your trading funds</p>

        <div class="cash-balance-display">
            <span class="cash-currency">$</span>
            <span class="cash-amount" id="cash-amount">@balance.ToString("N2")</span>
        </div>

        <div class="cash-message">
            <p>Add or withdraw funds to manage your account balance. Enter the amount below.</p>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="color: #dc3545; margin-top: 10px; font-weight: 600;">
                    @TempData["Error"]
                </div>
            }
        </div>

        <div class="amount-selector">
            <button type="button" class="btn-adjust minus" onclick="adjustAmount(-10)">-</button>
            <input type="number" name="amount" id="cash-amount-input" value="100" min="10" step="10" class="input-amount" />
            <button type="button" class="btn-adjust plus" onclick="adjustAmount(10)">+</button>
        </div>

        <div class="cash-actions">
            <form asp-controller="Trade" asp-action="AddCash" method="post" class="cash-form" onsubmit="syncAmount(this)">
                <input type="hidden" name="amount" class="hidden-amount" />
                <button type="submit" class="btn-add-cash">
                    <span class="btn-icon">&#43;</span> Add Funds
                </button>
            </form>

            <form asp-controller="Trade" asp-action="WithdrawCash" method="post" class="cash-form" onsubmit="syncAmount(this)">
                <input type="hidden" name="amount" class="hidden-amount" />
                <button type="submit" class="btn-withdraw-cash">
                    <span class="btn-icon">&#8722;</span> Withdraw
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function adjustAmount(delta) {
        const input = document.getElementById('cash-amount-input');
        let val = parseInt(input.value) || 0;
        val = Math.max(10, val + delta);
        input.value = val;
    }

    function syncAmount(form) {
        const amount = document.getElementById('cash-amount-input').value;
        form.querySelector('.hidden-amount').value = amount;
    }
</script>
