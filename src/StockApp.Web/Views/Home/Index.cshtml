@model StockApp.Models.PortfolioSummary

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Portfolio Dashboard</h1>
        <p class="text-muted">Welcome back to your stock portfolio overview.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Portfolio Value</div>
            <div class="stat-value">$@Model.TotalPortfolioValue.ToString("N2")</div>
            <div class="stat-footer stats-positive">
                &#9650; $@Model.DayChange.ToString("N2") (+@Model.DayChangePercentage.ToString("F2")%)
                <span class="footer-label">today</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Stocks Held</div>
            <div class="stat-value">@Model.TotalStocksHeld</div>
            <div class="stat-footer">
                <span class="footer-label">Across 4 Sectors</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Available Cash</div>
            <div class="stat-value">$45,210.00</div>
            <div class="stat-footer">
                <span class="footer-label">Ready to trade</span>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="section-card">
            <h2>Market Activity</h2>
            <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #fafafa; border: 1px dashed #ddd; border-radius: 8px; color: #888;">
                [ Portfolio Trend Visualization Placeholder ]
            </div>
        </div>
    </div>
</div>
